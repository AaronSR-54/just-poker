{
  "name": "just-poker-tmp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n web,online \"npm:dev\" \"npm:dev:server\"",
    "build": "tsc -b && vite build",
    "android": "bash scripts/build-android.sh",
    "android:debug": "bash scripts/build-android.sh debug",
    "store:assets": "node scripts/generate-store-assets.mjs",
    "store:screenshots": "node scripts/screenshots.mjs",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:ai": "AI_BENCH=1 vitest run src/ai/behavior.test.ts",
    "test:online": "node scripts/online-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@socket.io/redis-adapter": "^8.3.0",
    "framer-motion": "^12.42.2",
    "ioredis": "^5.11.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.6",
    "oxlint": "^1.71.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
